# 复制本文件为 .env 后填写（.env 已被 .gitignore 忽略，不会上传到 GitHub）
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
# DeepSeek 可用 OPENAI_BASE_URL=https://api.deepseek.com 与 OPENAI_MODEL=deepseek-chat
# 超时是网络操作阈值，并非整轮业务流程的硬性耗时上限；不自动重试以免反复等待
OPENAI_TIMEOUT=30
OPENAI_MAX_RETRIES=0
OPENAI_MAX_TOKENS=1200
